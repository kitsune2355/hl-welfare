# คัดลอกเป็น backend/.env แล้วกรอกค่า (.env ไม่ขึ้น repo)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=happyland_welfare
DB_USER=root
DB_PASS=
APP_TZ=Asia/Bangkok
APP_BASE_PATH=               # path ที่วางระบบบน host เช่น /hl-welfare (ใช้ตัด prefix + เป็น path ของ cookie)
CORS_ORIGIN=                 # ว่าง = ไม่เปิด CORS (หน้าเว็บกับ API อยู่ origin เดียวกัน)

# ----- การเข้าสู่ระบบ (สเปกข้อ 10.9.1) -----
COOKIE_SECURE=1              # 1 = cookie ส่งเฉพาะ HTTPS (production ต้องเป็น 1) · auto = ตามคำขอ · 0 = ทดสอบบน http เท่านั้น
SESSION_IDLE_MINUTES=30      # ไม่ใช้งานเกินนี้ session หมด (มี "จดจำฉัน" → ต่ออายุเองด้วย refresh token)
SESSION_ABSOLUTE_HOURS=12    # session อายุสูงสุดนับจาก login/refresh
REFRESH_TOKEN_DAYS=30        # อายุ refresh token (นับใหม่ทุกครั้งที่หมุน)
REFRESH_GRACE_SECONDS=10     # ใช้โทเคนที่เพิ่งหมุนซ้ำภายในกี่วินาทีถือว่าแท็บแข่งกัน (409) ไม่ใช่โทเคนรั่ว
LOGIN_MAX_FAILS_PER_USER=5
LOGIN_MAX_FAILS_PER_IP=20
LOGIN_WINDOW_MINUTES=15

# ----- ระบบสต็อก HR (stock_hr) — กุญแจต้องตรงกับ stock_hr/config_ctrl/welfare_key.php -----
STOCK_API_URL=http://localhost/stock_hr/api/welfare.php
STOCK_API_SECRET=
