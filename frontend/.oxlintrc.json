{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["react", "react-*", "**/application/**", "**/infrastructure/**", "**/shared/**", "**/ui/**", "**/features/**", "**/app/**"], "message": "domain ต้อง pure — import ได้เฉพาะ domain" }
        ] }]
      }
    },
    {
      "files": ["src/domain/**/*.test.ts"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["src/application/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["react", "react-*", "**/infrastructure/**", "**/shared/**", "**/ui/**", "**/features/**", "**/app/**"], "message": "application import ได้เฉพาะ domain" }
        ] }]
      }
    },
    {
      "files": ["src/infrastructure/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["react", "react-*", "**/shared/**", "**/ui/**", "**/features/**", "**/app/**"], "message": "infrastructure import ได้เฉพาะ application + domain" }
        ] }]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["**/domain/**", "**/application/**", "**/infrastructure/**", "**/features/**", "**/app/**"], "message": "ui (design system) ห้ามรู้จัก domain" }
        ] }]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["**/infrastructure/**"], "message": "features ต้องใช้ API ผ่าน useApi() เท่านั้น" }
        ] }]
      }
    }
  ]
}
